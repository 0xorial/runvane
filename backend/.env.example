# Backend environment — copy to backend/.env (`npm run setup` does this for you).
#
# SQLite database. The path is resolved relative to backend/prisma (Prisma's
# schema dir), so this points at backend/prisma/backend.sqlite — the same file
# the runtime uses by default. Leave as-is unless you want the DB elsewhere.
DATABASE_URL="file:./prisma/backend.sqlite"

# LLM providers (OpenAI, OpenRouter, LM Studio, …) are configured in the app's
# Settings UI and stored in the database — you do NOT need to set API keys here.
# Tip: point it at a local LM Studio server to run fully free / offline.
