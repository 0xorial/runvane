generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

model Conversation {
  id                      String            @id
  title                   String
  groupId                 String?           @map("group_id")
  isDeleted               Boolean           @default(false) @map("is_deleted")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")
  lastMessageAt           DateTime          @default(now()) @map("last_message_at")
  promptTokensTotal       Int               @default(0) @map("prompt_tokens_total")
  cachedPromptTokensTotal Int               @default(0) @map("cached_prompt_tokens_total")
  completionTokensTotal   Int               @default(0) @map("completion_tokens_total")
  /** Sum of provider-reported costs (e.g. OpenRouter's `usage.cost`) across turns that reported one. */
  providerCostTotal       Float             @default(0) @map("provider_cost_total")
  /** True once a turn consumed tokens but its provider didn't report a cost, so `providerCostTotal` is a lower bound, not the true total. */
  providerCostPartial     Boolean           @default(false) @map("provider_cost_partial")
  defaultViewLeafEntryId  String?           @map("default_view_leaf_entry_id")
  toolSandboxId           String?           @map("tool_environment_id")
  forkedFromConversationId String?          @map("forked_from_conversation_id")
  forkedFromEntryId       String?           @map("forked_from_entry_id")
  group                   ConversationGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  chatEntries             ChatEntry[]

  @@index([forkedFromConversationId])
  @@map("conversations")
}

model ChatEntry {
  id                String       @id
  conversationId    String       @map("conversation_id")
  conversationIndex Int          @map("conversation_index")
  parentId          String?      @map("parent_id")
  isSide            Boolean      @default(false) @map("is_side")
  type              String
  payloadJson       String       @map("payload_json")
  createdAt         DateTime     @default(now()) @map("created_at")
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, conversationIndex])
  @@index([parentId])
  @@map("chat_entries")
}

model ConversationGroup {
  id            String         @id
  name          String         @unique
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  conversations Conversation[]

  @@map("conversation_groups")
}

model Agent {
  id                         String   @id
  name                       String
  systemPrompt               String   @default("") @map("system_prompt")
  defaultLlmConfigurationJson Json?   @map("default_llm_configuration_json")
  defaultModelPresetId       Int?     @map("default_model_preset_id")
  modelProviderId            String?  @map("model_provider_id")
  modelName                  String?  @map("model_name")
  isDefault                  Int      @default(0) @map("is_default")
  icon                       String?
  color                      String?
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  @@map("agents")
}

model LlmProviderSetting {
  id             String   @id
  label          String
  settingsJson   Json     @map("settings_json")
  modelsJson     Json     @map("models_json")
  /// Catalog pricing captured at discovery (model name → USD per 1M rates),
  /// null for providers that don't publish it. Refreshed on every verify.
  modelsPricingJson Json? @map("models_pricing_json")
  modelsVerified Boolean  @default(false) @map("models_verified")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("llm_providers")
}

model AppSetting {
  key       String   @id
  valueJson Json     @map("value_json")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model ModelPreset {
  id            Int      @id @default(autoincrement())
  name          String
  parametersJson Json    @map("parameters_json")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("model_presets")
}

model ModelCapability {
  providerId             String   @map("provider_id")
  modelName              String   @map("model_name")
  supportsImageInput     Boolean? @map("supports_image_input")
  supportsFileInput      Boolean? @map("supports_file_input")
  maxContextTokens       Int?     @map("max_context_tokens")
  maxOutputTokens        Int?     @map("max_output_tokens")
  inputCostPer1m         Float?   @map("input_cost_per_1m")
  cachedInputCostPer1m   Float?   @map("cached_input_cost_per_1m")
  outputCostPer1m        Float?   @map("output_cost_per_1m")
  selfHosted             Boolean? @map("self_hosted")
  currency               String?
  source                 String?  @default("discovered")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@id([providerId, modelName])
  @@map("model_capabilities")
}

model ModelCapabilityOverride {
  providerId             String   @map("provider_id")
  modelName              String   @map("model_name")
  supportsImageInput     Boolean? @map("supports_image_input")
  supportsFileInput      Boolean? @map("supports_file_input")
  maxContextTokens       Int?     @map("max_context_tokens")
  maxOutputTokens        Int?     @map("max_output_tokens")
  inputCostPer1m         Float?   @map("input_cost_per_1m")
  cachedInputCostPer1m   Float?   @map("cached_input_cost_per_1m")
  outputCostPer1m        Float?   @map("output_cost_per_1m")
  selfHosted             Boolean? @map("self_hosted")
  currency               String?
  notes                  String?
  updatedBy              String?  @map("updated_by")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@id([providerId, modelName])
  @@map("model_capability_overrides")
}

model UploadAttachment {
  id         String   @id
  name       String
  mimeType   String   @map("mime_type")
  sizeBytes  Int      @map("size_bytes")
  content    Bytes
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("uploads")
}

// Global monotonic stream cursor (single row, id=0). Bumped in the same
// transaction as each chat_entries mutation; its value is the event seq and the
// snapshot watermark. Accessed via raw SQL, so the generated client need not
// know it — kept here only as the schema source of truth.
model StreamCursor {
  id    Int @id @default(0)
  value Int @default(0)

  @@map("stream_cursor")
}

// One row per tool execution attempt. The tool-invocation chat entry is the
// transcript surface (mutated in place on approve/retry); this table is the
// immutable per-attempt audit and the base for retrying failed runs.
model ToolRun {
  id             String    @id
  conversationId String    @map("conversation_id")
  chatEntryId    String    @map("chat_entry_id")
  agentId        String?   @map("agent_id")
  toolId         String    @map("tool_id")
  /** 1 for the first execution of an entry, +1 per retry. */
  attempt        Int       @default(1)
  retryOfRunId   String?   @map("retry_of_run_id")
  status         String // running | done | error | aborted
  parametersJson Json      @map("parameters_json")
  resultJson     Json?     @map("result_json")
  error          String?
  /// Streamed progress log (stdout, streamed tokens, …), tail-capped.
  outputLog      String?   @map("output_log")
  startedAt      DateTime  @map("started_at")
  finishedAt     DateTime? @map("finished_at")
  elapsedMs      Int?      @map("elapsed_ms")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([conversationId])
  @@index([chatEntryId])
  @@map("tool_runs")
}

// A user message accepted while a run was in flight, waiting its turn. Persisted
// so a backend restart cannot drop text the user already typed — boot drains
// leftovers instead (the in-memory queue this replaces lost them silently).
model PendingMessage {
  seq             Int      @id @default(autoincrement())
  conversationId  String   @map("conversation_id")
  clientRequestId String?  @map("client_request_id")
  dtoJson         Json     @map("dto_json")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([conversationId, seq])
  @@map("pending_messages")
}
