# Copy to .env and edit for a REAL exit node (a VPS), instead of the bundled
# reference exit-node container. Then run only the `enabler` service:
#   docker compose up -d --build enabler
#
# The VPS just needs an sshd with a forward-only "tunnel" user whose
# authorized_keys contains keys/tunnel.pub (the exit-node/ image is one way to
# get that; a hand-configured sshd works too).

EXIT_HOST=your.vps.example.com
EXIT_USER=tunnel
EXIT_PORT=22
