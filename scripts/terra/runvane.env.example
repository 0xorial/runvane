# Environment for the runvane harness on terra. Copy to ~/runvane.env of the
# `runvane` service user; the systemd unit loads it with EnvironmentFile= and
# scripts/terra/deploy.sh sources it. Paths below assume the checkout lives in
# ~/app (RUNVANE_APP_DIR) and all state under ~/data — both on the tank
# dataset that backs /data/projects/runvane/service, never on the system disk.

# Port from terra's port plan. The backend binds all interfaces, so this is
# reachable on the LAN without a login (decision 2026-10-17).
PORT=52230

# Same origin as the backend: it serves the built frontend itself.
FRONTEND_ORIGIN=http://10.0.0.100:52230
RUNVANE_FRONTEND_DIST=/data/projects/runvane/service/app/frontend/dist

# State. The SQLite file and the per-sandbox ssh key material.
DATABASE_URL=file:/data/projects/runvane/service/data/backend.sqlite
RUNVANE_SANDBOX_DATA_DIR=/data/projects/runvane/service/data/sandboxes

# The tool-host source the harness ships to ssh sandboxes on first contact.
RUNVANE_TOOLHOST_SRC_DIR=/data/projects/runvane/service/app/toolhost/src

NODE_ENV=production

# Only `prisma migrate deploy` (run by deploy.sh) needs an engine; the running
# app is engine-free. On NixOS the CLI cannot download one, so point this at
# nixpkgs' prisma-engines. deploy.sh falls back to `schema-engine` on PATH.
#PRISMA_SCHEMA_ENGINE_BINARY=/run/current-system/sw/bin/schema-engine

# Optional: the search/browse backend (ai-browsing-enabler), if it runs on terra.
#RUNVANE_WEB_SEARCH_ENDPOINT=http://127.0.0.1:8080
#RUNVANE_WEB_BROWSE_ENDPOINT=http://127.0.0.1:3000
