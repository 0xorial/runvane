# Single dev container for runvane: mounts the live workspace and runs the
# backend (nest --watch) + frontend (vite) together. node_modules are shadowed
# by named volumes (see dev-entry.sh) so the Mac's macOS-native binaries on the
# virtiofs share are never used and no Linux binaries leak back onto the share.
#
# bookworm (glibc), not alpine — rolldown/lightningcss/Prisma want -gnu binaries.
# Node 22, not 20: the backend imports the built-in `node:sqlite` (rag-store),
# which only exists in Node 22.5+. Matches the host's v22.x. N-API keeps the
# shadow-volume native deps (Prisma engine, rolldown, lightningcss) ABI-compatible.
FROM node:22-bookworm-slim

# procps provides `ps`, which @nestjs/cli's watch-mode restart (tree-kill) shells
# out to (`ps -A -o pid,ppid`) to find the app process behind its `sh -c node …`
# wrapper. The slim base has no `ps`; without it tree-kill finds no children and
# kills only the shell wrapper, so the node app orphans holding the backend port
# and every rebuild dies with EADDRINUSE while stale code keeps serving. With
# `ps` present, `nest start --watch` restarts cleanly (verified by A/B test).
#
# openssh-client + docker-cli: docker sandboxes — the app creates sandbox
# containers on the daemon whose socket rv-up.sh mounts in, and connects to
# them with real ssh over `docker exec … sshd -i` (ssh-keygen makes the
# per-sandbox keys). docker.io would drag in a full daemon; the CLI package
# alone is what we want.
RUN apt-get update \
 && apt-get install -y --no-install-recommends procps openssh-client ca-certificates curl gnupg \
 && install -m 0755 -d /etc/apt/keyrings \
 && curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian bookworm stable" \
      > /etc/apt/sources.list.d/docker.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends docker-ce-cli \
 && rm -rf /var/lib/apt/lists/*

COPY dev-entry.sh /usr/local/bin/dev-entry.sh
RUN chmod +x /usr/local/bin/dev-entry.sh

# Defaults; override per-run with -e. DATABASE_URL is absolute to remove any
# doubt about Prisma's relative-path resolution — it points at the workspace DB.
ENV BACKEND_PORT=52200 \
    FRONTEND_PORT=52201 \
    FRONTEND_ORIGIN=http://localhost:52201 \
    VITE_API_BASE_URL=http://localhost:52200 \
    DATABASE_URL=file:/workspace/backend/prisma/backend.sqlite

WORKDIR /workspace
EXPOSE 52200 52201
CMD ["/usr/local/bin/dev-entry.sh"]
