{
  "moduleFileExtensions": ["js", "json", "ts"],
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "rootDir": "./integration",
  "testRegex": ".integration.spec.ts$",
  "testEnvironment": "node",
  "testTimeout": 120000,
  "maxWorkers": 1,
  "moduleDirectories": ["<rootDir>/../../backend/node_modules", "node_modules"],
  "transform": {
    "^.+\\.(t|j)s$": [
      "<rootDir>/../../backend/node_modules/ts-jest",
      { "tsconfig": "<rootDir>/../tsconfig.integration.json", "diagnostics": false }
    ]
  },
  "transformIgnorePatterns": ["/node_modules/(?!zodex/)"],
  "reporters": [
    "default",
    ["<rootDir>/../metrics/jest-reporter.cjs", { "suite": "integration" }]
  ]
}
