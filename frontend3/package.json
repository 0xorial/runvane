{
  "name": "runvane-frontend3",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node ../dev-ports/with-ports.mjs --cwd . -- vite",
    "build": "npm run check && vite build",
    "preview": "node ../dev-ports/with-ports.mjs --cwd . -- vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "typecheck": "npm run check",
    "test:e2e": "E2E_FRONTEND_DIR=frontend3 E2E_FRONTEND_PORT_OFFSET=5 node ../scripts/run-e2e.mjs",
    "test:e2e:servers:stop": "node ../scripts/e2e-servers.mjs stop"
  },
  "dependencies": {
    "@tanstack/svelte-query": "^6.0.13"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.12.3",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.8",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^8.0.12"
  }
}
